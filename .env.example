# Copy to .env (gitignored). devenv loads it. Defaults shown; see docs/architecture.md.
# devenv sets DATABASE_URL=postgres://tuita@localhost/tuita; it is required outside devenv.
# DATABASE_URL=postgres://tuita@localhost/tuita
# BIND_ADDR=127.0.0.1:8080
# REQUEST_TIMEOUT_SECS=30
# LOG_FORMAT=pretty
# RUST_LOG=info
# PUBLIC_URL=http://127.0.0.1:8080
# DATA_DIR=./data
# STORAGE=local          # local (files under DATA_DIR/media) or s3
# S3_BUCKET=             # STORAGE=s3: required
# S3_REGION=us-east-1
# S3_ENDPOINT=           # MinIO, R2, B2, Garage; unset means AWS S3
# S3_ACCESS_KEY_ID=      # STORAGE=s3: required, with the secret
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=         # default: true when S3_ENDPOINT is set
# S3_PREFIX=             # key prefix inside the bucket
# SECURE_COOKIES=        # default: true when PUBLIC_URL is https
# TRUST_PROXY=false
# ADMIN_HANDLE=
# MAX_VIDEO_MB=50
# FEDERATION_ALLOW_HTTP= # default: true when PUBLIC_URL is http
# FEDERATION_ALLOW_PRIVATE_NETS=false # DEV/TEST ONLY: lets federation reach loopback and private addresses (SSRF risk); never inferred
# SOURCE_URL=            # AGPL: where users get the running source
# MESSAGES_E2EE_REQUIRED=true # false lets two local accounts exchange plaintext until both have a message key
# SECRET_KEY=          # 32 bytes as 64 hex characters or base64 (openssl rand -hex 32): encrypts the ActivityPub signing keys in the database. Keep it with your backups, apart from the dump; losing it loses those keys
